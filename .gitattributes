# Normalize text files to LF in the repository, check out native on Windows.
* text=auto

*.py text diff=python
*.md text
*.csv text
*.json text
*.yml text
*.yaml text
*.toml text
*.cfg text
*.cff text

# Generated artifacts keep their exact bytes
*.png binary
*.jpg binary
*.pdf binary
*.docx binary
*.pptx binary
*.gif binary
